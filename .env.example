# tap-microsoft-dynamics-bc configuration
# Copy this file to .env and fill in your values. See README.md › Setup.

# Required: Microsoft Entra tenant ID (GUID) or primary domain
TAP_MICROSOFT_DYNAMICS_BC_TENANT_ID=00000000-0000-0000-0000-000000000000

# Required: Entra app registration (service-to-service)
TAP_MICROSOFT_DYNAMICS_BC_CLIENT_ID=00000000-0000-0000-0000-000000000000
TAP_MICROSOFT_DYNAMICS_BC_CLIENT_SECRET=your_client_secret_value

# Optional: Business Central environment name (default: production)
TAP_MICROSOFT_DYNAMICS_BC_ENVIRONMENT_NAME=sandbox

# Optional: earliest modification time for incremental streams (ISO-8601 date-time)
TAP_MICROSOFT_DYNAMICS_BC_START_DATE=2026-01-01T00:00:00Z

# On-premises only: server instance URL (replaces the online environment URL)
# TAP_MICROSOFT_DYNAMICS_BC_BASE_URL=https://bc.example.com:7048/BC
